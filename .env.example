# .env.example — Template for local environment variables.
#
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is listed in .gitignore and will NEVER be committed.
# .env.example is committed so teammates know what variables are needed.
# Never put real secrets in this file.

# --- Django ---
# Generate a new secret key at: https://djecrety.ir/
# Or run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (e.g. localhost,127.0.0.1,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CBB Data API ---
# Sign up at: https://cbbdata.com (or wherever the API key is obtained)
# Used in opencourt/services.py for fetching team and player data
CBB_API_KEY=your-api-key-here

# --- Database (production only) ---
# Leave blank for local development — SQLite is used automatically.
# Set this to your PostgreSQL URL when deploying to Railway or Render (Week 7).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
