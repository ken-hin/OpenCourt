# .gitignore — Tells git which files and folders to never track.
# Add a pattern here any time you have a file that should stay local
# and never be pushed to the shared repo.


# --- Python ---
# Compiled bytecode generated automatically by Python. Never commit these.
__pycache__/
*.py[cod]
*.pyo

# Egg/packaging artifacts from pip
*.egg-info/
dist/
build/


# --- Virtual Environment ---
# The .venv folder holds all installed packages locally.
# Each teammate runs `uv sync` to recreate it — it should never be committed.
.venv/


# --- Django ---
# Local SQLite database. Each developer has their own local copy.
# In production we'll use PostgreSQL (see Schedule.md Week 7).
db.sqlite3

# Collected static files generated by `python manage.py collectstatic`.
# Only relevant in production — not committed to the repo.
staticfiles/
static_root/

# Django log files
*.log


# --- Environment Variables ---
# Store secrets (API keys, database URLs, SECRET_KEY) in a .env file locally.
# NEVER commit this file — it contains sensitive credentials.
.env
.env.*
!.env.example


# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride


# --- IDEs & Editors ---
# PyCharm / IntelliJ
.idea/

# VS Code
.vscode/

# Vim
*.swp
*.swo


# --- Node / Frontend Tooling ---
# Tailwind CSS and DaisyUI are installed via npm into theme/static_src/node_modules/.
# These packages are large (50+ MB) and fully reproducible — never commit them.
# Each teammate regenerates them with: python manage.py tailwind install
node_modules/

# NOTE: theme/static/css/dist/styles.css (the compiled Tailwind output) is
# intentionally NOT listed here, so it IS committed to the repo.
# This means the site renders correctly even before a teammate runs `tailwind start`.
# After editing templates or styles.css, run `python manage.py tailwind build`
# and commit the updated styles.css so everyone stays in sync.


# --- Testing & Coverage ---
.coverage
coverage/
htmlcov/
.pytest_cache/


# --- Miscellaneous ---
# uv-generated placeholder (not needed for the Django project)
main.py
